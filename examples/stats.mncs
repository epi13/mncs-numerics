mncs 0.16;

// Dataset statistics over one window: a consumer-integration test for
// mncs.numerics.vec_float_reduce.v1. All vocabulary comes through
// `use`; nothing is re-implemented here.

module mncs.numerics.examples.stats.v1;

use mncs.numerics.vec_float_reduce;
use mncs.numerics.vec_float_mask;

fn report4(xs: [f64; 4]) -> (result: [f64; 4]) {
    // [mean, variance, min, max] of the window.
    return [mean(xs), variance(xs), min(xs), max(xs)];
}

fn report8(xs: [f64; 8]) -> (result: [f64; 4]) {
    return [mean(xs), variance(xs), min(xs), max(xs)];
}

fn l1_linf4(xs: [f64; 4]) -> (result: [f64; 2]) {
    return [l1(xs), linf(xs)];
}

// Masked window report: [live-lane sum, live count, reciprocal sum]
// over the lanes the mask keeps. A consumer-integration test for
// mncs.numerics.vec_float_mask.v1: dead lanes may hold zeros without
// disturbing the reciprocal arm.
fn report_masked4(xs: [f64; 4], m: [bool; 4]) -> (result: [f64; 3]) {
    return [masked_sum(xs, m), (count_live(m) as f64), recip_sum(xs, m)];
}
