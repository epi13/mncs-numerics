mncs 0.16;

// P-005 (RESOLVED): trace_g over a NON-square matrix. The language
// still has no general dimension-equality constraints, but trace_g
// now takes a single Nat parameter N naming both dimensions, so the
// seed below cannot elaborate: MNE221 "generic argument count
// mismatch for 'trace_g': expected 1, got 2". The silent partial
// diagonal (1.0 + 5.0 = 6.0) is gone; the hazard is a compile error.

module dim.probe;

use mncs.numerics.mat_float;

fn wide_trace(m: [[f64; 3]; 2]) -> (result: f64) {
    return trace_g<2, 3>(m);
}
