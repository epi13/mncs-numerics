mncs 0.16;

// Property-style drivers over construction. Since the P-001 repair
// every property runs on all five backends with no refusal pins;
// companions to prop_drivers_reduce.mncs, which covers reductions.

module mncs.numerics.test.prop_drivers_build.v1;

use mncs.numerics.vec_float_reduce;
use mncs.numerics.vec_float_build;

// add(x, zeros_like(x)) == x, witnessed by a zero L1 residual.
fn prop_add_zero() -> (result: bool) {
    let xs: [f64; 4] = [1.5, -2.5, 1e16, -1e16];
    let back: [f64; 4] = add(xs, zeros_like(xs));
    return sum(abs_elem(sub(back, xs))) == 0.0;
}

// scaled(x, 1.0) == x, same witness shape.
fn prop_scale_one() -> (result: bool) {
    let xs: [f64; 4] = [1.5, -2.5, 1e16, -1e16];
    let back: [f64; 4] = scaled(xs, 1.0);
    return sum(abs_elem(sub(back, xs))) == 0.0;
}

// (Transpose-involution and matmul-identity properties live in
// prop_drivers_reduce.mncs: they need only literal construction.
// Since the P-001 repair every property runs on all five backends.
